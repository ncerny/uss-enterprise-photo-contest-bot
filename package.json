{
  "name": "uss-enterprise-photo-contest-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Discord photo contest bot with web app",
  "workspaces": [
    "bot",
    "web",
    "functions",
    "shared"
  ],
  "scripts": {
    "dev:bot": "npm run dev --workspace=bot",
    "dev:web": "npm run dev --workspace=web",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "migrate:up": "node bot/scripts/migrations/run.js up",
    "migrate:down": "node bot/scripts/migrations/run.js down",
    "migrate:status": "node bot/scripts/migrations/run.js status",
    "seed:dev": "node bot/scripts/seeds/dev-seed.js",
    "commands:deploy": "npm run commands:deploy --workspace=bot",
    "commands:docs": "npm run commands:docs --workspace=bot"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
