# Copy this file to .env and fill in your values
# The .env file is gitignored and won't be committed

# Discord OAuth2 Configuration (non-sensitive)
DISCORD_CLIENT_ID=your_discord_client_id

# Comma-separated list of allowed redirect URIs
ALLOWED_REDIRECT_URIS=http://localhost:5002/auth/callback,https://your-project.web.app/auth/callback

# DISCORD_CLIENT_SECRET is stored in Google Cloud Secret Manager
# Set it with: firebase functions:secrets:set DISCORD_CLIENT_SECRET
