    "chrono-node": "^2.9.0",
    "discord-api-types": "^0.37.83",
    "discord.js": "^14.14.1",
    "dotenv": "^16.3.1",
    "firebase-admin": "^12.0.0",
    "sharp": "^0.33.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^5.0.0",
    "winston-transport": "^4.7.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.7.0"
  }
