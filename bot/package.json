{
  "name": "@uss-enterprise/bot",
  "version": "0.1.0",
  "private": true,
  "description": "Discord bot for photo contests",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "commands:deploy": "tsx scripts/register-commands.ts",
    "commands:docs": "tsx scripts/register-commands.ts --docs-only"
  },
  "dependencies": {
