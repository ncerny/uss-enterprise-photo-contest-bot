rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserId() {
      return request.auth.uid;
    }
    
    // Contests collection
    match /contests/{contestId} {
      // Anyone can read contests
      allow read: if true;
      
      // Only authenticated users can create contests
      // In production, you may want to restrict this to admins only
      allow create: if isAuthenticated()
        && request.resource.data.createdBy == getUserId()
        && request.resource.data.status == 'created';
      
      // Only contest creator can update
      allow update: if isAuthenticated()
        && resource.data.createdBy == getUserId();
      
      // Only contest creator can delete
      allow delete: if isAuthenticated()
        && resource.data.createdBy == getUserId();
    }
    
    // Helper to get contest data
    function getContest(contestId) {
      return get(/databases/$(database)/documents/contests/$(contestId)).data;
    }

    // Helper to check if contest is in submission period
    function isContestInSubmissionPeriod(contestId) {
      return getContest(contestId).status == 'submission';
    }

    // Submissions collection
    match /submissions/{submissionId} {
      // Anyone can read submissions (needed for voting display)
      allow read: if true;

      // Users can create their own submissions during submission period
      allow create: if isAuthenticated()
        && request.resource.data.userId == getUserId()
        && isContestInSubmissionPeriod(request.resource.data.contestId);

      // Users can only update their own submissions during submission period
      allow update: if isAuthenticated()
        && resource.data.userId == getUserId()
        && isContestInSubmissionPeriod(resource.data.contestId);

      // Users can only delete their own submissions during submission period
      allow delete: if isAuthenticated()
        && resource.data.userId == getUserId()
        && isContestInSubmissionPeriod(resource.data.contestId);
    }
    
    // Votes collection
    match /votes/{voteId} {
      // Anyone can read votes (for counting)
      allow read: if true;
      
      // Users can create votes
      allow create: if isAuthenticated()
        && request.resource.data.voterId == getUserId();
      
      // Users cannot update votes (must delete and recreate)
      allow update: if false;
      
      // Users can only delete their own votes
      allow delete: if isAuthenticated()
        && resource.data.voterId == getUserId();
    }
  }
}
